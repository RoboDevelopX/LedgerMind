# Nebius Token Factory key (https://tokenfactory.nebius.com -> API keys). Leave empty for offline mock mode.
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Everything else lives in config.yaml. Optional overrides:
# LEDGERMIND_CURRENCY=INR            # or USD
# LEDGERMIND_DB=ledgermind.db
# LEDGERMIND_STRICT=1                # privacy strict mode: aggregates only
# LEDGERMIND_MOCK=1                  # force offline mode even with a key
# LEDGERMIND_PROACTIVE=0             # disable the background scheduler
# LEDGERMIND_MODEL_SUPER=nvidia/...  # override any model alias from config.yaml
# LEDGERMIND_MULTIUSER=1             # every browser gets its own ledger (public demos)
